queryTorrents:
SELECT *
FROM Torrents;

queryTorrentById:
SELECT *
FROM Torrents
WHERE hash=:torrent_hash;

queryTorrentByName:
SELECT *
FROM Torrents
WHERE name=:name;

queryPieceById:
SELECT *
FROM Pieces
WHERE number=:piece_number AND torrent_hash=:torrent_hash;

queryPiecesByTorrent:
SELECT *
FROM Pieces
WHERE torrent_hash=:torrent_hash;

queryPiecesByPeer:
SELECT Pieces.hash AS hash, Pieces.length AS length, Pieces.number AS number, Pieces.status AS status, Pieces.download_path AS download_path, Pieces.torrent_hash AS torrent_hash
FROM Pieces INNER JOIN PeerHasPiece ON (Pieces.torrent_hash=PeerHasPiece.torrent_hash AND Pieces.number = PeerHasPiece.piece_number)
WHERE (PeerHasPiece.torrent_hash=:torrent_hash AND PeerHasPiece.peer_id_hash=:id_hash);


queryFileById:
SELECT *
FROM Files
WHERE number=:file_number AND torrent_hash=:torrent_hash;

queryFilesByTorrent:
SELECT *
FROM Files
WHERE torrent_hash=:torrent_hash;

queryPeerById:
SELECT *
FROM Peers
WHERE id_hash = :id_hash AND torrent_hash = :torrent_hash;

queryPeersByPiece:
SELECT Peers.address AS address, Peers.id_hash AS id_hash, Peers.torrent_hash AS torrent_hash
FROM Peers INNER JOIN PeerHasPiece ON (Peers.id_hash=PeerHasPiece.peer_id_hash AND Peers.torrent_hash=PeerHasPiece.torrent_hash)
WHERE PeerHasPiece.torrent_hash=:torrent_hash AND PeerHasPiece.piece_number=:piece_number;

queryPeersByTorrent:
SELECT address, id_hash, torrent_hash
FROM Peers
WHERE torrent_hash=:torrent_hash;