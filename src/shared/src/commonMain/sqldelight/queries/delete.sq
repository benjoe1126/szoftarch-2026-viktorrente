deleteTorrentByTorrentId:
DELETE FROM Torrents
WHERE hash=:torrent_hash;

deletePieceByPieceId:
DELETE FROM Pieces
WHERE torrent_hash=:torrent_hash AND number=:number;

deleteFileByFileId:
DELETE FROM Files
WHERE torrent_hash=:torrent_hash AND number=:number;

deletePeerByPeerId:
DELETE FROM Peers
WHERE torrent_hash=:torrent_hash AND address=:address;

deletePhpByTorrentId:
DELETE FROM PeerHasPiece
WHERE torrent_hash=:torrent_hash;

deletePhpByPieceId:
DELETE FROM PeerHasPiece
WHERE torrent_hash=:torrent_hash AND piece_number=:number;

deletePhpByPeerId:
DELETE FROM PeerHasPiece
WHERE torrent_hash=:torrent_hash AND peer_address=:address;