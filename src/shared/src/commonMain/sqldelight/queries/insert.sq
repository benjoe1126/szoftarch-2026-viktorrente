insertTorrent:
INSERT INTO Torrents (hash, name, tracker, length, status, mode, file_path, download_dir)
VALUES (:hash, :name,:tracker,:length,:status,:mode,:file_path,:download_dir);

insertPiece:
INSERT INTO Pieces (hash, length, torrent_hash, number, status, download_path)
VALUES (:hash, :length, :torrent_hash, :number, :status, :download_path);

insertFile:
INSERT INTO Files (name, length, torrent_hash, number)
VALUES (:name, :length, :torrent_hash, :number);

insertPeer:
INSERT INTO Peers (address, id_hash, torrent_hash, status)
VALUES (:address, :id_hash, :torrent_hash, :status);

insertPeerOffering:
INSERT INTO PeerHasPiece (torrent_hash, peer_id_hash, piece_number)
VALUES (:torrent_hash, :peer_id_hash, :piece_number);

affectedRows:
SELECT changes();
