updateTorrentById:
UPDATE Torrents
SET name=:name, tracker=:tracker, length=:length
WHERE id=:torrent_id;

updatePieceById:
UPDATE Pieces
SET hash=:hash, length=:length, status=:status, download_path=:download_path
WHERE torrent_id=:torrent_id AND number=:number;

updateFileById:
UPDATE Files
SET name=:name, length=:length
WHERE torrent_id=:torrent_id AND number=:number;

affectedRows:
SELECT changes();