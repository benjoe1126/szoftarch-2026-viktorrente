updateTorrentById:
UPDATE Torrents
SET name=:name, tracker=:tracker, length=:length, status=:status, mode=:mode, file_path=:file_path
WHERE hash=:torrent_hash;

updatePieceById:
UPDATE Pieces
SET hash=:hash, length=:length, status=:status, download_path=:download_path
WHERE torrent_hash=:torrent_hash AND number=:number;

updateFileById:
UPDATE Files
SET name=:name, length=:length
WHERE torrent_hash=:torrent_hash AND number=:number;

updatePeerById:
UPDATE Peers
SET address=:address, status=:status
WHERE torrent_hash=:torrent_hash AND id_hash=:id_hash;

affectedRows:
SELECT changes();